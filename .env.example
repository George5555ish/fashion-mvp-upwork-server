OPENAI_API_KEY=your_openai_api_key_here
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/fashion-analyzer
PORT=5000

# Required for AI outfit detection
# OPENAI_API_KEY + MONGODB_URI above

# eBay Browse API — primary product search (sandbox keys from developer.ebay.com → Application Keys)
EBAY_CLIENT_ID=your_sandbox_app_id
EBAY_CLIENT_SECRET=your_sandbox_cert_id
EBAY_ENV=sandbox
EBAY_MARKETPLACE=EBAY_US
USE_EBAY_API=true

# Optional — affiliate tracking on shop links (EPN campaign ID, leave empty for sandbox testing)
EBAY_CAMPAIGN_ID=

# Auth — required for user accounts, albums, closet, and admin
JWT_SECRET=change_this_to_a_long_random_secret
# Email that receives admin role on register/login (e.g. client account)
ADMIN_EMAIL=hello@outfind.com

# SerpAPI — Google Shopping product search (https://serpapi.com/google-shopping-api)
SERPAPI_KEY=your_serpapi_key_here
USE_SERPAPI=true
SERPAPI_GL=us
SERPAPI_HL=en
SERPAPI_GOOGLE_DOMAIN=google.com
